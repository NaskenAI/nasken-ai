# Copy this file to .env.local and fill in the values
# .env.local is gitignored — never commit secrets

# Required — contact form (app/api/contact/route.ts) sends via Resend
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@nasken.ai

# Optional — analytics
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=nasken.ai
